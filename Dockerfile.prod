# ---------------------------------------------------
# Stage 1: Builder
# ---------------------------------------------------
FROM node:18-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files (ensures cached layer if only code changes)
COPY package*.json ./

# Install all dependencies (dev + prod)
RUN npm ci

# Copy the rest of the source code
COPY . .

# (Optional) Build step, e.g., TypeScript transpile or bundling
# RUN npm run build


# ---------------------------------------------------
# Stage 2: Production
# ---------------------------------------------------
FROM node:18-alpine AS production

# Create non-root user
RUN addgroup -g 1001 -S nodejs \
 && adduser -S nodejs -u 1001

WORKDIR /app

# Copy only package files first (to keep cache layers efficient)
COPY package*.json ./

# Copy production node_modules from builder (skip re-install)
COPY --from=builder /app/node_modules ./node_modules

# Copy only required application files
COPY --from=builder --chown=nodejs:nodejs /app/src ./src
COPY --from=builder --chown=nodejs:nodejs /app/public ./public
COPY --from=builder --chown=nodejs:nodejs /app/ecosystem.config.json ./

# Create runtime directories
RUN mkdir -p uploads logs && chown -R nodejs:nodejs uploads logs

# Switch to non-root user
USER nodejs

# Expose backend port
EXPOSE 4000

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4000/api/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })" || exit 1

# Start the application
CMD ["npm", "start"]
