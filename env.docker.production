# =============================================================================
# SABY BACKEND ENVIRONMENT CONFIGURATION - PRODUCTION
# =============================================================================
# Environment: production
NODE_ENV=production
PORT=4000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Configuration (Production)
# CRITICAL: Password must match MONGO_ROOT_PASSWORD from .env file
MONGODB_URL=mongodb://admin:mongodb_prod_2025_secure@mongodb:27017/halo-prod?authSource=admin&replicaSet=rs0

# PostgreSQL Configuration (Production)
# CRITICAL: Use halograph (NOT halograph_staging) for production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=${POSTGRES_USER:-halograph_user}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=halograph

# Redis Configuration (Production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_prod_2025
REDIS_DB=0

# =============================================================================
# NODE SYNC CONFIGURATION
# =============================================================================
NODE_SYNC_ENABLED=true
NODE_SYNC_BATCH_SIZE=${NODE_SYNC_BATCH_SIZE:-100}

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# S3 Configuration (Production)
STORAGE_PROVIDER=aws-s3

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_REGION=${AWS_REGION:-us-east-1}
AWS_BUCKET_NAME=${AWS_BUCKET_NAME}

# Google Drive Configuration (if needed)
GOOGLE_DRIVE_CLIENT_ID=${GOOGLE_DRIVE_CLIENT_ID}
GOOGLE_DRIVE_CLIENT_SECRET=${GOOGLE_DRIVE_CLIENT_SECRET}
GOOGLE_DRIVE_REFRESH_TOKEN=${GOOGLE_DRIVE_REFRESH_TOKEN}
GOOGLE_DRIVE_FOLDER_ID=${GOOGLE_DRIVE_FOLDER_ID}

# UploadThing Configuration (if needed)
UPLOADTHING_SECRET=${UPLOADTHING_SECRET}
UPLOADTHING_APP_ID=${UPLOADTHING_APP_ID}

# =============================================================================
# JWT CONFIGURATION (REQUIRED)
# =============================================================================
JWT_SECRET=${JWT_SECRET}
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
SABYFE_URL=${SABYFE_URL:-https://dashboard.saby.ai}

# =============================================================================
# EMAIL CONFIGURATION (SMTP) - PRODUCTION
# =============================================================================
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
EMAIL_FROM=${EMAIL_FROM:-noreply@saby.ai}

# =============================================================================
# SMS CONFIGURATION
# =============================================================================
SMS_BASE_URL=https://api.termii.com
SMS_API_KEY=${SMS_API_KEY}

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_WEBHOOK_URL=${TELEGRAM_WEBHOOK_URL}
TELEGRAM_POLLING_INTERVAL=1000
TELEGRAM_SESSION_TTL=3600

# =============================================================================
# WHATSAPP BUSINESS API CONFIGURATION
# =============================================================================
PHONE_NUMBER_ID=${PHONE_NUMBER_ID}
VERIFY_TOKEN=${VERIFY_TOKEN}
WHATSAPP_TOKEN=${WHATSAPP_TOKEN}

# =============================================================================
# SOCKET.IO CONFIGURATION
# =============================================================================
SOCKET_CORS_ORIGIN=${SOCKET_CORS_ORIGIN:-https://dashboard.saby.ai}
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# =============================================================================
# EMAIL INGESTION CONFIGURATION
# =============================================================================
DEMO_IMAP_USER=dummy-imap-user
DEMO_IMAP_PASS=dummy-imap-pass
DEMO_IMAP_HOST=imap.gmail.com
DEMO_TENANT_ID=demo-tenant
DEMO_PROJECT_ID=test-project
DEMO_FORM_ID=test-form
DEMO_NODE_ID=test-node
DEMO_AUTHORIZED_SENDERS=admin@example.com,user@example.com
SMTP_HOST_EMAIL_INGESTION=${SMTP_HOST_EMAIL_INGESTION:-smtp.gmail.com}
EMAIL_INGESTION_API_KEY=${EMAIL_INGESTION_API_KEY}

# =============================================================================
# API CONFIGURATION
# =============================================================================
SUBMISSION_API_BASE_URL=${SUBMISSION_API_BASE_URL:-http://backend:4000/v1}
SUBMISSION_API_TIMEOUT_MS=10000
SUBMISSION_API_MAX_RETRIES=3

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================
EMAIL_INGESTOR_INTERVAL_MS=60000
ANALYTICS_REFRESH_CRON=*/15 * * * *
SUBMISSION_ROLLUP_REFRESH_MS=10000

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
EMAIL_PROVIDER_DISABLED=${EMAIL_PROVIDER_DISABLED:-false}

# =============================================================================
# NOTES:
# - This file contains all required environment variables for production
# - Values marked with ${VAR} should be set via environment or .env file
# - Keep this file secure and never commit secrets to version control
# - For production deployment, set actual values for all ${VAR} placeholders
# - Database name is halograph (NOT halograph_staging) - CRITICAL!
# =============================================================================

